##
# Covenant — пример окружения для локального OpenProject.
# Скопируй в .env и задай свои секреты:
#   cp .env.example .env
#
# Документация переменных:
#   https://www.openproject.org/docs/installation-and-operations/configuration/environment/
#
# Имя стека (кириллический путь workspace ломает дефолт Compose)
COMPOSE_PROJECT_NAME=covenant2
TAG=17-slim
OPENPROJECT_HTTPS=false
OPENPROJECT_HSTS=false
# Сгенерируй: openssl rand -hex 32
SECRET_KEY_BASE=OVERWRITE_ME
OPENPROJECT_HOST__NAME=localhost:8082
PORT=127.0.0.1:8082
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
IMAP_ENABLED=false
DATABASE_URL=postgres://postgres:p4ssw0rd@db/openproject?pool=20&encoding=unicode&reconnect=true
POSTGRES_PASSWORD=p4ssw0rd
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16
# Локальные пути (Windows / Docker Desktop). На Linux можно named volumes.
PGDATA=./data/pg
OPDATA=./data/assets
COLLABORATIVE_SERVER_URL=ws://localhost:8082/hocuspocus
# Сгенерируй: openssl rand -hex 24
COLLABORATIVE_SERVER_SECRET=OVERWRITE_ME
POSTGRES_VERSION=17

OPENPROJECT_DEFAULT__PROJECTS__MODULES=work_package_tracking
OPENPROJECT_SHOW__COMMUNITY__LINKS=false
OPENPROJECT_APIV3__ENABLE__BASIC__AUTH=true
# Выключить 2FA (иначе после admin/admin редирект на 2FA wizard)
OPENPROJECT_PLUGIN__OPENPROJECT__TWO__FACTOR__AUTHENTICATION={"disabled":true,"active_strategies":[],"enforced":false}
# Только русский интерфейс
OPENPROJECT_DEFAULT__LANGUAGE=ru
OPENPROJECT_AVAILABLE__LANGUAGES=ru
OPENPROJECT_APP__TITLE=Пульс
# Community only: без Enterprise-тизеров и страницы EE
OPENPROJECT_EE__HIDE__BANNERS=true
OPENPROJECT_EE__MANAGER__VISIBLE=false
# ^/work_packages/?$ — только глобальный индекс; не /work_packages/:id/activities
# ^/account/register|lost_password — выпилены (регистрация/сброс пароля не будет)
# якоря ^ обязательны: голый /shares режет /api/v3/.../shares и ломает таблицу заданий
OPENPROJECT_BLACKLISTED__ROUTES=^/admin/enterprise ^/shares/?$ ^/portfolios ^/gantt ^/work_packages/?$ ^/work_packages/details ^/roadmap ^/documents ^/account/register ^/account/lost_password
# Имена модулей — внутренние идентификаторы OpenProject (не имена gem-папок).
# meetings/board_view отключай только после первого успешного seed.
OPENPROJECT_DISABLED__MODULES=backlogs costs budgets meetings board_view team_planner_view calendar_view github gitlab gantt wiki repository forums news documents
# Дефолтное предприятие после логина (fallback, если у юзера нет membership)
COVENANT_DEFAULT_ENTERPRISE=pao-koks

# LDAP не подключён.
OPENPROJECT_SEED_LDAP_PMH_HOST=
OPENPROJECT_SEED_LDAP_PMH_BINDPASSWORD=
OPENPROJECT_SEED_LDAP_PMH_BINDUSER=
OPENPROJECT_SEED_LDAP_PMH_BASEDN=

# --- SMTP. Пусто — письма наружу не уходят.
OPENPROJECT_EMAIL__DELIVERY__METHOD=
OPENPROJECT_SMTP__ADDRESS=
OPENPROJECT_SMTP__PORT=25
OPENPROJECT_SMTP__DOMAIN=localhost
OPENPROJECT_SMTP__AUTHENTICATION=none
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=false
OPENPROJECT_SMTP__OPENSSL__VERIFY__MODE=none
OPENPROJECT_MAIL__FROM=
